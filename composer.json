{
    "name": "solution25/ebizcharge-shopware67-payment-plugin",
    "description": "EBizCharge payment plugin for Shopware 6.7 using the REST hosted webform flow.",
    "type": "shopware-platform-plugin",
    "license": "proprietary",
    "version": "1.0.5",
    "authors": [
        {
            "name": "solution25",
            "homepage": "https://solution25.com/en/"
        }
    ],
    "require": {
        "php": ">=8.2",
        "shopware/core": ">=6.7.0.0 <6.8.0.0",
        "shopware/storefront": ">=6.7.0.0 <6.8.0.0",
        "shopware/administration": ">=6.7.0.0 <6.8.0.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "EbizChargeShopware\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EbizChargeShopware\\Tests\\": "tests/"
        }
    },
    "extra": {
        "shopware-plugin-class": "EbizChargeShopware\\EbizChargeShopware",
        "plugin-icon": "src/Resources/config/plugin.png",
        "label": {
            "en-GB": "EBizCharge for Shopware 6.7",
            "de-DE": "EBizCharge fuer Shopware 6.7"
        },
        "description": {
            "en-GB": "REST-only EBizCharge payment plugin for Shopware 6.7 with hosted checkout, admin connection diagnostics, and provider-verified finalize handling without raw payment data.",
            "de-DE": "REST-only EBizCharge Zahlungsplugin fuer Shopware 6.7 mit gehostetem Checkout, Admin-Verbindungsdiagnose und verifiziertem Finalize ohne Rohzahlungsdaten im Shop."
        },
        "manufacturerLink": {
            "en-GB": "https://solution25.com/en/",
            "de-DE": "https://solution25.com/en/"
        },
        "supportLink": {
            "en-GB": "https://solution25.com/en/contact/",
            "de-DE": "https://solution25.com/en/contact/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true,
            "php-http/discovery": true
        }
    }
}
