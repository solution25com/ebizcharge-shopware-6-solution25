<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="EbizChargeShopware\Controller\Api\AdminDiagnosticsController" public="true">
            <argument type="service" id="EbizChargeShopware\Service\Configuration\PluginConfigProvider"/>
            <argument type="service" id="EbizChargeShopware\Service\Connection\ConnectionTestService"/>
            <argument type="service" id="EbizChargeShopware\Service\PaymentLinkService"/>
            <argument type="service" id="EbizChargeShopware\Storage\TransactionRecordStoreInterface"/>
            <argument type="service" id="logger"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="EbizChargeShopware\Controller\Storefront\WebhookController" public="true">
            <argument type="service" id="EbizChargeShopware\Service\Configuration\PluginConfigProvider"/>
            <argument type="service" id="EbizChargeShopware\Storage\TransactionRecordStoreInterface"/>
            <argument type="service" id="Shopware\Core\Checkout\Order\Aggregate\OrderTransaction\OrderTransactionStateHandler"/>
            <argument type="service" id="EbizChargeShopware.logger"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="EbizChargeShopware\Controller\Storefront\EbizChargeSavedCardsController" public="true">
            <argument type="service" id="EbizChargeShopware\Service\EbizChargeCustomerVaultService"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="EbizChargeShopware\Controller\Storefront\PaymentLinkReturnController" public="true">
            <argument type="service" id="EbizChargeShopware\Service\Checkout\OrderTransactionLoader"/>
            <argument type="service" id="EbizChargeShopware\Service\Configuration\PluginConfigProvider"/>
            <argument type="service" id="EbizChargeShopware\Service\Finalize\FinalizationService"/>
            <argument type="service" id="EbizChargeShopware\Service\PaymentLinkService"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="twig"/>
            <argument type="service" id="router"/>
            <tag name="controller.service_arguments"/>
        </service>
    </services>
</container>
