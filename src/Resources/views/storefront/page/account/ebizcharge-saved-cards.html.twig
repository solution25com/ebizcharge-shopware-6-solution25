{% sw_extends '@Storefront/storefront/page/account/_page.html.twig' %}

{% block page_account_main_content %}
    <div class="account-ebizcharge-saved-cards"
         data-ebiz-charge-saved-cards-plugin
         {% if addCardUrl %}
             data-ebiz-charge-saved-cards-plugin-options="{{ {
                 reloadUrl: path('frontend.account.ebizcharge.saved-cards.index')
             }|json_encode|e('html_attr') }}"
         {% endif %}
    >
        {% set savedCardMethods = savedPaymentMethods|filter(method => method.type|default('card') != 'ach') %}
        {% set savedAchMethods = savedPaymentMethods|filter(method => method.type|default('card') == 'ach') %}
        {% set supportedCardIcons = ['visa', 'mastercard', 'amex', 'discover', 'diners', 'jcb', 'unionpay'] %}

        <div class="account-ebizcharge-saved-cards__header">
            <div>
                <h1 class="account-ebizcharge-saved-cards__title">{{ 'ebizcharge.account.title'|trans }}</h1>
                <p class="account-ebizcharge-saved-cards__intro text-muted">{{ 'ebizcharge.account.intro'|trans }}</p>
            </div>

            {% if not addCardUrl %}
                <a href="{{ path('frontend.account.ebizcharge.saved-cards.add') }}"
                   class="btn btn-primary account-ebizcharge-saved-cards__add"
                   data-ebiz-saved-method-add-link
                   data-ebiz-loading-message="{{ 'ebizcharge.account.loadingAddPaymentMethod'|trans|e('html_attr') }}">
                    {{ 'ebizcharge.account.addCard'|trans }}
                </a>
            {% endif %}
        </div>

        {% if addCardUrl %}
            <a href="{{ path('frontend.account.ebizcharge.saved-cards.index') }}"
               class="btn btn-outline-secondary ebiz-add-card-back"
               data-ebiz-saved-method-cancel-add-link
               data-ebiz-loading-message="{{ 'ebizcharge.account.loadingSavedPaymentMethods'|trans|e('html_attr') }}">
                <span class="ebiz-add-card-back__icon" aria-hidden="true">←</span>
                <span>{{ 'ebizcharge.account.backToSavedPaymentMethods'|trans }}</span>
            </a>

            <div class="ebiz-add-card-frame-wrap">
                <iframe
                    class="ebiz-add-card-frame"
                    src="{{ addCardUrl }}"
                    title="{{ 'ebizcharge.account.addCard'|trans }}"
                    loading="eager"
                    referrerpolicy="origin"
                    allow="payment"
                ></iframe>
            </div>
        {% else %}
            {% if savedPaymentMethods is empty %}
                <p>{{ 'ebizcharge.account.empty'|trans }}</p>
            {% else %}
                <section class="ebiz-saved-methods-section">
                    <h2 class="ebiz-saved-methods-section__title">{{ 'ebizcharge.account.creditCardsTitle'|trans }}</h2>

                    {% if savedCardMethods is empty %}
                        <p class="ebiz-saved-methods-section__empty text-muted">{{ 'ebizcharge.account.emptyCreditCards'|trans }}</p>
                    {% else %}
                        <div class="ebiz-payment-method-list">
                            {% for method in savedCardMethods %}
                                {% set last4Digits = method.last4Digits|default(method.masked|default('')|slice(-4)) %}
                                {% set brandKey = method.brandKey|default('card') %}
                                {% set cardLabel = method.brand|default('Card') %}
                                <div class="ebiz-payment-method-row{% if method.isDefault %} ebiz-payment-method-row--default{% endif %}">
                                    <div class="ebiz-payment-method-row__main">
                                        <span class="ebiz-payment-method-row__logo" aria-hidden="true">
                                            {% if brandKey in supportedCardIcons %}
                                                <img
                                                    class="ebiz-payment-method-row__logo-image"
                                                    src="{{ asset('bundles/ebizchargeshopware/storefront/assets/payment/logo/' ~ brandKey ~ '-logo.svg') }}"
                                                    alt=""
                                                    width="32"
                                                    height="21"
                                                    loading="lazy">
                                            {% else %}
                                                <span class="ebiz-payment-method-row__logo-text">CARD</span>
                                            {% endif %}
                                        </span>
                                        <span class="ebiz-payment-method-row__details">
                                            <strong class="ebiz-payment-method-row__title">
                                                {{ cardLabel }}{% if last4Digits %} ···· {{ last4Digits }}{% endif %}
                                                {% if method.isDefault %}
                                                    <span class="ebiz-payment-method-row__default">{{ 'ebizcharge.account.defaultBadge'|trans }}</span>
                                                {% endif %}
                                            </strong>
                                            <span class="ebiz-payment-method-row__meta text-muted">
                                                {% if method.methodName %}{{ method.methodName }}{% endif %}
                                                {% if method.methodName and method.expiry %} · {% endif %}
                                                {% if method.expiry %}{{ 'ebizcharge.account.expires'|trans }} {{ method.expiry }}{% endif %}
                                            </span>
                                        </span>
                                    </div>
                                    <div class="ebiz-payment-method-row__actions">
                                        {% if method.isDefault %}
                                            <span class="ebiz-payment-method-row__default ebiz-payment-method-row__default--mobile">{{ 'ebizcharge.account.defaultBadge'|trans }}</span>
                                        {% else %}
                                            <form method="post"
                                                  action="{{ path('frontend.account.ebizcharge.saved-cards.default') }}"
                                                  data-ebiz-saved-method-default-form
                                                  data-ebiz-loading-message="{{ 'ebizcharge.account.updatingPaymentMethods'|trans|e('html_attr') }}">
                                                <input type="hidden" name="savedMethodId" value="{{ method.id }}">
                                                <button type="submit" class="btn btn-sm ebiz-payment-method-row__action">{{ 'ebizcharge.account.setDefault'|trans }}</button>
                                            </form>
                                        {% endif %}
                                        <form method="post"
                                              action="{{ path('frontend.account.ebizcharge.saved-cards.delete') }}"
                                              data-ebiz-saved-method-delete-form
                                              data-ebiz-loading-message="{{ 'ebizcharge.account.removingPaymentMethod'|trans|e('html_attr') }}"
                                              data-ebiz-confirm-message="{{ 'ebizcharge.account.deleteConfirm'|trans|e('html_attr') }}">
                                            <input type="hidden" name="savedMethodId" value="{{ method.id }}">
                                            <button type="submit" class="btn btn-sm ebiz-payment-method-row__action ebiz-payment-method-row__action--danger">{{ 'ebizcharge.account.delete'|trans }}</button>
                                        </form>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </section>

                <section class="ebiz-saved-methods-section">
                    <h2 class="ebiz-saved-methods-section__title">{{ 'ebizcharge.account.bankAccountsTitle'|trans }}</h2>

                    {% if savedAchMethods is empty %}
                        <p class="ebiz-saved-methods-section__empty text-muted">{{ 'ebizcharge.account.emptyBankAccounts'|trans }}</p>
                    {% else %}
                        <div class="ebiz-payment-method-list">
                            {% for method in savedAchMethods %}
                                {% set last4Digits = method.last4Digits|default(method.masked|default('')|slice(-4)) %}
                                {% set accountType = method.brand|default('') %}
                                {% if accountType is empty or accountType|lower == 'bank account' %}
                                    {% set accountLabel = method.displayType|default('Bank account') %}
                                {% else %}
                                    {% set accountLabel = accountType ~ ' account' %}
                                {% endif %}
                                {% set bankTitle = method.methodName ?: method.accountHolder|default('') ?: accountLabel %}
                                {% set bankMetaParts = [accountLabel] %}
                                {% if method.routingLast4Digits|default('') %}
                                    {% set bankMetaParts = bankMetaParts|merge(['Routing ···' ~ method.routingLast4Digits]) %}
                                {% endif %}
                                <div class="ebiz-payment-method-row{% if method.isDefault %} ebiz-payment-method-row--default{% endif %}">
                                    <div class="ebiz-payment-method-row__main">
                                        <span class="ebiz-payment-method-row__logo" aria-hidden="true">
                                            <img
                                                class="ebiz-payment-method-row__logo-image ebiz-payment-method-row__logo-image--bank"
                                                src="{{ asset('bundles/ebizchargeshopware/storefront/assets/payment/logo/bank-logo.svg') }}"
                                                alt=""
                                                width="24"
                                                height="24"
                                                loading="lazy">
                                        </span>
                                        <span class="ebiz-payment-method-row__details">
                                            <strong class="ebiz-payment-method-row__title">
                                                {{ bankTitle }}{% if last4Digits %} ···· {{ last4Digits }}{% endif %}
                                                {% if method.isDefault %}
                                                    <span class="ebiz-payment-method-row__default">{{ 'ebizcharge.account.defaultBadge'|trans }}</span>
                                                {% endif %}
                                            </strong>
                                            <span class="ebiz-payment-method-row__meta text-muted">{{ bankMetaParts|join(' · ') }}</span>
                                        </span>
                                    </div>
                                    <div class="ebiz-payment-method-row__actions">
                                        {% if method.isDefault %}
                                            <span class="ebiz-payment-method-row__default ebiz-payment-method-row__default--mobile">{{ 'ebizcharge.account.defaultBadge'|trans }}</span>
                                        {% else %}
                                            <form method="post"
                                                  action="{{ path('frontend.account.ebizcharge.saved-cards.default') }}"
                                                  data-ebiz-saved-method-default-form
                                                  data-ebiz-loading-message="{{ 'ebizcharge.account.updatingPaymentMethods'|trans|e('html_attr') }}">
                                                <input type="hidden" name="savedMethodId" value="{{ method.id }}">
                                                <button type="submit" class="btn btn-sm ebiz-payment-method-row__action">{{ 'ebizcharge.account.setDefault'|trans }}</button>
                                            </form>
                                        {% endif %}
                                        <form method="post"
                                              action="{{ path('frontend.account.ebizcharge.saved-cards.delete') }}"
                                              data-ebiz-saved-method-delete-form
                                              data-ebiz-loading-message="{{ 'ebizcharge.account.removingPaymentMethod'|trans|e('html_attr') }}"
                                              data-ebiz-confirm-message="{{ 'ebizcharge.account.deleteConfirm'|trans|e('html_attr') }}">
                                            <input type="hidden" name="savedMethodId" value="{{ method.id }}">
                                            <button type="submit" class="btn btn-sm ebiz-payment-method-row__action ebiz-payment-method-row__action--danger">{{ 'ebizcharge.account.delete'|trans }}</button>
                                        </form>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </section>
            {% endif %}
        {% endif %}

        <div class="modal fade ebiz-saved-methods-confirm-modal"
             id="ebizSavedMethodDeleteConfirmModal"
             tabindex="-1"
             aria-hidden="true"
             data-ebiz-delete-confirm-modal>
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-body">
                        <p class="ebiz-saved-methods-confirm-message mb-0" data-ebiz-delete-confirm-message>
                            {{ 'ebizcharge.account.deleteConfirm'|trans|sw_sanitize }}
                        </p>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal"
                                data-ebiz-delete-confirm-cancel>
                            {{ 'ebizcharge.account.deleteCancel'|trans|sw_sanitize }}
                        </button>

                        <button type="button"
                                class="btn btn-danger"
                                data-ebiz-delete-confirm-submit>
                            {{ 'ebizcharge.account.deleteConfirmAction'|trans|sw_sanitize }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
