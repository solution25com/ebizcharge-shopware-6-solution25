{% sw_extends '@Storefront/storefront/page/account/_page.html.twig' %}

{% block page_account_main_content %}
    <div class="account-ebizcharge-saved-cards"
         data-ebiz-charge-saved-cards-plugin
         {% if addCardUrl %}
             data-ebiz-charge-saved-cards-plugin-options="{{ {
                 reloadUrl: path('frontend.account.ebizcharge.saved-cards.index')
             }|json_encode|e('html_attr') }}"
         {% endif %}
    >
        <h1 class="account-ebizcharge-saved-cards__title">{{ 'ebizcharge.account.title'|trans }}</h1>
        <p class="text-muted">{{ 'ebizcharge.account.intro'|trans }}</p>

        {% set savedCardMethods = savedPaymentMethods|filter(method => method.type|default('card') != 'ach') %}
        {% set savedAchMethods = savedPaymentMethods|filter(method => method.type|default('card') == 'ach') %}

        <div class="mb-4 d-flex gap-2 flex-wrap align-items-center">
            <a href="{{ path('frontend.account.ebizcharge.saved-cards.index', { addCard: '1' }) }}" class="btn btn-primary">
                {{ 'ebizcharge.account.addCard'|trans }}
            </a>

            {% if savedAchMethods is not empty %}
                <details class="ebiz-bank-methods">
                    <summary class="btn btn-outline-secondary ebiz-bank-methods__toggle">
                        <span data-ebiz-bank-toggle-label
                              data-show-label="{{ 'ebizcharge.account.showBankAccounts'|trans({'%count%': savedAchMethods|length})|e('html_attr') }}"
                              data-hide-label="{{ 'ebizcharge.account.hideBankAccounts'|trans|e('html_attr') }}">
                            {{ 'ebizcharge.account.showBankAccounts'|trans({'%count%': savedAchMethods|length}) }}
                        </span>
                    </summary>
                </details>
            {% endif %}
        </div>

        {% if addCardUrl %}
            <div class="ebiz-add-card-frame-wrap mb-4">
                <iframe
                    class="ebiz-add-card-frame"
                    src="{{ addCardUrl }}"
                    title="{{ 'ebizcharge.account.addCard'|trans }}"
                    loading="eager"
                    referrerpolicy="origin"
                    allow="payment"
                ></iframe>
            </div>
        {% endif %}

        {% if savedAchMethods is not empty %}
            <div class="ebiz-bank-methods__panel mb-4" hidden data-ebiz-bank-methods-panel>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0 ebiz-bank-methods__table">
                        <tbody>
                            {% for method in savedAchMethods %}
                                <tr>
                                    <td>
                                        <strong>{{ method.methodName ?: method.displayType|default('Bank account') }}</strong>
                                        <div class="text-muted small">{{ method.brand|default('Checking') }} · {{ method.masked }}</div>
                                    </td>
                                    <td class="text-end">
                                        {% if method.isDefault %}
                                            <span class="badge bg-success me-1">{{ 'ebizcharge.account.defaultBadge'|trans }}</span>
                                        {% else %}
                                            <form method="post" action="{{ path('frontend.account.ebizcharge.saved-cards.default') }}" class="d-inline">
                                                <input type="hidden" name="savedMethodId" value="{{ method.id }}">
                                                <button type="submit" class="btn btn-xs btn-outline-secondary ebiz-bank-methods__action">{{ 'ebizcharge.account.setDefault'|trans }}</button>
                                            </form>
                                        {% endif %}
                                        <form method="post" action="{{ path('frontend.account.ebizcharge.saved-cards.delete') }}" class="d-inline ms-1"
                                              onsubmit="return confirm('{{ 'ebizcharge.account.deleteConfirm'|trans|e('js') }}');">
                                            <input type="hidden" name="savedMethodId" value="{{ method.id }}">
                                            <button type="submit" class="btn btn-xs btn-outline-danger ebiz-bank-methods__action">{{ 'ebizcharge.account.delete'|trans }}</button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}

        {% if savedPaymentMethods is empty %}
            <p>{{ 'ebizcharge.account.empty'|trans }}</p>
        {% else %}
            {% if savedCardMethods is not empty %}
                <div class="row g-3">
                    {% for method in savedCardMethods %}
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="ebiz-wallet-card{% if method.isDefault %} ebiz-wallet-card--default{% endif %}">
                                <div class="ebiz-wallet-card__brand">{{ method.brand|default(method.displayType|default('Payment method')) }}</div>
                                <div class="ebiz-wallet-card__number">{{ method.masked|default('Saved payment method') }}</div>
                                <div class="ebiz-wallet-card__meta">
                                    {% if method.expiry %}
                                        <span>{{ 'ebizcharge.account.expires'|trans }} {{ method.expiry }}</span>
                                    {% endif %}
                                    {% if method.methodName %}
                                        <span class="d-block text-truncate">{{ method.methodName }}</span>
                                    {% endif %}
                                </div>
                                {% if method.isDefault %}
                                    <span class="ebiz-wallet-card__default-badge">{{ 'ebizcharge.account.defaultBadge'|trans }}</span>
                                {% endif %}
                                <div class="ebiz-wallet-card__actions mt-3">
                                    {% if not method.isDefault %}
                                        <form method="post" action="{{ path('frontend.account.ebizcharge.saved-cards.default') }}" class="d-inline">
                                            <input type="hidden" name="savedMethodId" value="{{ method.id }}">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">{{ 'ebizcharge.account.setDefault'|trans }}</button>
                                        </form>
                                    {% endif %}
                                    <form method="post" action="{{ path('frontend.account.ebizcharge.saved-cards.delete') }}" class="d-inline ms-1"
                                          onsubmit="return confirm('{{ 'ebizcharge.account.deleteConfirm'|trans|e('js') }}');">
                                        <input type="hidden" name="savedMethodId" value="{{ method.id }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">{{ 'ebizcharge.account.delete'|trans }}</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
